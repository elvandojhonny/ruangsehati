<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="42dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/Widget.PeminjamanRuang.BackSimple"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tambah Ruangan"
            android:textAppearance="@style/TextAppearance.PeminjamanRuang.Title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNamaRuang"
            style="@style/Widget.PeminjamanRuang.EditText.Soft"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:hint="Nama Ruangan" />

        <EditText
            android:id="@+id/etLokasi"
            style="@style/Widget.PeminjamanRuang.EditText.Soft"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:hint="Lokasi" />

        <EditText
            android:id="@+id/etKapasitas"
            style="@style/Widget.PeminjamanRuang.EditText.Soft"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:hint="Kapasitas" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpanRuang"
            style="@style/Widget.PeminjamanRuang.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Simpan Ruangan" />
    </LinearLayout>
</ScrollView>
