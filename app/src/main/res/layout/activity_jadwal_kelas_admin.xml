<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="165dp"
        android:background="@drawable/bg_dashboard_user_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="48dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            style="@style/Widget.PeminjamanRuang.BackSimple.Light"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitoring Realtime"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Jadwal Kelas"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_dashboard_chip_icon"
            android:gravity="center"
            android:text="🏫"
            android:textSize="26sp"/>
    </LinearLayout>

    <!-- ================= CONTENT ================= -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="-28dp"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="@color/dashboard_surface"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/dashboard_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Penggunaan Ruang"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pantau kelas yang sedang digunakan pengguna"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="13sp"/>

            <!-- TABLE CARD -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/dashboard_surface_elevated"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/dashboard_stroke"
                app:strokeWidth="1dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!-- HEADER TABLE -->

                        <LinearLayout
                            android:layout_width="760dp"
                            android:layout_height="wrap_content"
                            android:background="@color/dashboard_surface"
                            android:orientation="horizontal"
                            android:paddingVertical="16dp">

                            <TextView
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Gedung"
                                android:textColor="@color/dashboard_gold"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="170dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Kelas"
                                android:textColor="@color/dashboard_gold"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="150dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Jam"
                                android:textColor="@color/dashboard_gold"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Status"
                                android:textColor="@color/dashboard_gold"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Peminjam"
                                android:textColor="@color/dashboard_gold"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- LIST -->

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerJadwal"
                            android:layout_width="760dp"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="true"
                            android:overScrollMode="never"
                            android:paddingBottom="12dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>