<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:background="@drawable/bg_hero_about"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnBack"
                style="@style/Widget.PeminjamanRuang.BackSimple"
                android:layout_gravity="start"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peminjaman Ruang"
                android:textAppearance="@style/TextAppearance.PeminjamanRuang.Body"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Form Peminjaman"
                android:textAppearance="@style/TextAppearance.PeminjamanRuang.Title"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CARD FORM -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PeminjamanRuang.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-18dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- INFORMASI PEMINJAM -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informasi Peminjam"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNamaPeminjam"
                    style="@style/Widget.PeminjamanRuang.EditText.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:hint="Nama Peminjam"
                    android:paddingHorizontal="14dp" />

                <EditText
                    android:id="@+id/etNamaGedung"
                    style="@style/Widget.PeminjamanRuang.EditText.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:hint="Nama Gedung"
                    android:paddingHorizontal="14dp" />

                <AutoCompleteTextView
                    android:id="@+id/etNamaRuang"
                    style="@style/Widget.PeminjamanRuang.EditText.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:hint="Pilih Ruang"
                    android:paddingHorizontal="14dp" />

                <!-- JADWAL -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Jadwal Peminjaman"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etTanggal"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:focusable="false"
                        android:hint="Tanggal"
                        android:inputType="none"
                        android:paddingHorizontal="14dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <EditText
                        android:id="@+id/etHari"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:focusable="false"
                        android:hint="Hari"
                        android:paddingHorizontal="14dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etJamMulai"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
                        android:focusable="false"
                        android:hint="Jam Mulai"
                        android:inputType="none"
                        android:paddingHorizontal="14dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <EditText
                        android:id="@+id/etJamSelesai"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
                        android:focusable="false"
                        android:hint="Jam Selesai"
                        android:inputType="none"
                        android:paddingHorizontal="14dp" />

                </LinearLayout>

                <!-- KETERANGAN -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Keterangan"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etKeterangan"
                    style="@style/Widget.PeminjamanRuang.EditText.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:gravity="top|start"
                    android:hint="Tambahkan keperluan peminjaman..."
                    android:inputType="textMultiLine"
                    android:padding="14dp" />

                <!-- BUTTON -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimpanPeminjaman"
                    style="@style/Widget.PeminjamanRuang.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="28dp"
                    android:text="Simpan Peminjaman"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>