<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:background="@drawable/bg_hero_about"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnBack"
                style="@style/Widget.PeminjamanRuang.BackSimple"
                android:layout_gravity="start"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manajemen Mahasiswa"
                android:textAppearance="@style/TextAppearance.PeminjamanRuang.Body"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Edit Data User"
                android:textAppearance="@style/TextAppearance.PeminjamanRuang.Title"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CARD -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PeminjamanRuang.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginTop="-18dp"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- IDENTITAS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Identitas Mahasiswa"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNama"
                    style="@style/Widget.PeminjamanRuang.EditText.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:hint="Nama Lengkap"
                    android:paddingHorizontal="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNim"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="NIM"
                        android:inputType="number"
                        android:paddingHorizontal="14dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <EditText
                        android:id="@+id/etNoHp"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="No HP"
                        android:inputType="phone"
                        android:paddingHorizontal="14dp" />

                </LinearLayout>

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/Widget.PeminjamanRuang.EditText.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:hint="Email Kampus"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp" />

                <!-- AKADEMIK -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Data Akademik"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etProdi"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Program Studi"
                        android:paddingHorizontal="14dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <EditText
                        android:id="@+id/etFakultas"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Fakultas"
                        android:paddingHorizontal="14dp" />

                </LinearLayout>

                <!-- ALAMAT -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Alamat"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAlamat"
                    style="@style/Widget.PeminjamanRuang.EditText.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:gravity="top|start"
                    android:hint="Alamat Lengkap"
                    android:inputType="textMultiLine"
                    android:padding="14dp" />

                <!-- AKUN -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Akun Login"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etUsername"
                        style="@style/Widget.PeminjamanRuang.EditText.Soft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Username"
                        android:paddingHorizontal="14dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <Spinner
                        android:id="@+id/spRole"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_soft" />

                </LinearLayout>

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/Widget.PeminjamanRuang.EditText.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:hint="Password Baru"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp" />

                <!-- BUTTON -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimpan"
                    style="@style/Widget.PeminjamanRuang.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="28dp"
                    android:text="Update User"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>