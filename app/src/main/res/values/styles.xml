<resources>

    <style name="TextAppearance.PeminjamanRuang.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PeminjamanRuang.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TextAppearance.PeminjamanRuang.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Elevated card — konsisten dengan dashboard -->
    <style name="Widget.PeminjamanRuang.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">@color/dashboard_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">22dp</item>
    </style>

    <style name="Widget.PeminjamanRuang.Card.Flat" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">@color/dashboard_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
    </style>

    <!-- Primary CTA (gold gradient) -->
    <style name="Widget.PeminjamanRuang.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_dashboard_button_gold</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">#55FFFFFF</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/dashboard_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Outlined / secondary — aksen emas -->
    <style name="Widget.PeminjamanRuang.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorSecondary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="rippleColor">@color/dashboard_stroke</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.PeminjamanRuang.Button.SecondaryTint" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">@color/dashboard_bg</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Tombol kembali -->
    <style name="Widget.PeminjamanRuang.BackSimple" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/back_chevron</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.PeminjamanRuang.BackSimple.Light" parent="Widget.PeminjamanRuang.BackSimple">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="Widget.PeminjamanRuang.IconButton.Back" parent="Widget.PeminjamanRuang.BackSimple" />

    <style name="Widget.PeminjamanRuang.EditText" parent="@style/Widget.PeminjamanRuang.EditText.Soft" />

    <style name="Widget.PeminjamanRuang.EditText.Soft">
        <item name="android:background">@drawable/bg_input_dashboard</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textColorHint">?android:attr/textColorSecondary</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.PeminjamanRuang.IconButton" parent="@style/Widget.PeminjamanRuang.IconButton.Back" />

    <style name="BottomNavTextAppearance"
        parent="TextAppearance.Material3.BodySmall">

        <item name="android:textSize">12sp</item>

        <item name="android:textStyle">bold</item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>

</resources>
